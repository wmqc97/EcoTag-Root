<?xml version="1.0" encoding="UTF-8"?>
<Widget frameRate="0" scaleByDensity="false" screenWidth="1080" version="2" useVariableUpdater="Battery,DateTime.Second">
  <!-- UriRoute 数据源：与 UriRoute 中登记的分组和脚本名称保持一致。 -->
  <!-- aodState 状态机：1=亮屏(正常显示)，0=熄屏AOD(内容调暗)；由 init/exitAod/resume/enterAod/pause 事件驱动 -->
  <Var name="aodState" type="number"/>
  <Var name="__isAod" expression="#aodState==0"/>
  <Var name="DATA_URI" type="string" expression="'content://uriroute/data?group=wmqc&amp;name=spec'" const="true"/>
  <Var name="UPDATE_URI" type="string" expression="'content://uriroute/update?group=wmqc&amp;name=spec'" const="true"/>
  <Var name="REFRESH_INTERVAL" type="number" expression="1" const="true"/>

  <!-- 以 336 宽度为设计基准，按实际屏幕宽度整体缩放。 -->
  <Var name="s" type="number" expression="(#view_width / 336)"/>
  <Var name="scale" type="number" expression="(#view_width / 336)"/>
  <Var name="font_path" type="string" expression="'/system/fonts/MiSansVF.ttf'" const="true"/>

  <!-- 所有可见文字均由 spec.js 返回；MAML 只负责图形、布局和可见性。 -->
  <Var name="resultData" type="jsonO" expression="newJsonObject()" const="true"/>
  <Var name="labelTitle" type="string" expression="''" const="true"/>
  <Var name="labelSubtitle" type="string" expression="''" const="true"/>
  <Var name="lowText" type="string" expression="''" const="true"/>
  <Var name="mediumText" type="string" expression="''" const="true"/>
  <Var name="highText" type="string" expression="''" const="true"/>
  <Var name="level1Text" type="string" expression="''" const="true"/>
  <Var name="level2Text" type="string" expression="''" const="true"/>
  <Var name="level3Text" type="string" expression="''" const="true"/>
  <Var name="level4Text" type="string" expression="''" const="true"/>
  <Var name="level5Text" type="string" expression="''" const="true"/>
  <Var name="manufacturerLabel" type="string" expression="''" const="true"/>
  <Var name="manufacturerText" type="string" expression="''" const="true"/>
  <Var name="modelLabel" type="string" expression="''" const="true"/>
  <Var name="modelText" type="string" expression="''" const="true"/>
  <Var name="currentLabel" type="string" expression="''" const="true"/>
  <Var name="currentText" type="string" expression="''" const="true"/>
  <Var name="powerLabel" type="string" expression="''" const="true"/>
  <Var name="powerText" type="string" expression="''" const="true"/>
  <Var name="gradeText" type="string" expression="''" const="true"/>
  <Var name="gradeIndex" type="string" expression="''" const="true"/>
  <Var name="grade1Visible" type="string" expression="''" const="true"/>
  <Var name="grade2Visible" type="string" expression="''" const="true"/>
  <Var name="grade3Visible" type="string" expression="''" const="true"/>
  <Var name="grade4Visible" type="string" expression="''" const="true"/>
  <Var name="grade5Visible" type="string" expression="''" const="true"/>
  <Var name="showCapsule" type="string" expression="'1'" const="true"/>

  <!-- 左侧电量胶囊：机型判断（宽高比，与主题版一致） -->
  <Var name="isProMax" type="number" expression="ifelse(gt(#view_width/#view_height,1.6),1,0)"/>
  <Var name="isPro" type="number" expression="(1 - #isProMax)"/>

  <!-- 缩放 + 胶囊左边距（ProMax → 320；Pro → 350，与主题版一致） -->
  <Var name="_scale" type="number" expression="(#view_width / 1080)"/>
  <Var name="x_left" type="number" expression="ifelse(#isProMax,320,350)*#_scale"/>

  <!-- 胶囊尺寸（与主题版一致） -->
  <Var name="capW" type="number" expression="(#x_left / #scale - 2)"/>
  <Var name="capH" type="number" expression="(#view_height / #scale - 2 - 5 / #scale)"/>
  <Var name="capR" type="number" expression="(#capW / 2)"/>
  <Var name="capX_center" type="number" expression="(#capR * #scale)"/>
  <Var name="capX_icon"   type="number" expression="ifelse(#isProMax,#capR*#scale,#capW*#scale*0.24)"/>
  <Var name="capX_num"    type="number" expression="ifelse(#isProMax,#capR*#scale,#capW*#scale*0.76)"/>
  <!-- 电量圆环颜色（根据电量阈值切换） -->
  <Var name="ringColor" type="string" expression="ifelse(le(#batteryLevel,15),'#FF4444',le(#batteryLevel,30),'#FF8C00',le(#batteryLevel,60),'#FFD54F','#4CAF50')"/>

  <!-- 充电流光驱动动画（无 name，VariableCommand 直接操作变量值） -->
  <Var name="chargeAnim" type="number" expression="0">
    <VariableAnimation initPause="true" loop="true">
      <Item value="0" time="0"/>
      <Item value="360" time="2000"/>
    </VariableAnimation>
  </Var>


  <!-- 胶囊电池进度变量 -->
  <Var name="seg1" type="number" expression="(3.14159 * #capR / 2)"/>
  <Var name="segL" type="number" expression="(#capH - #capW)"/>
  <Var name="seg3" type="number" expression="(3.14159 * #capR)"/>
  <Var name="e1" type="number" expression="#seg1"/>
  <Var name="e2" type="number" expression="(#e1 + #segL)"/>
  <Var name="e3" type="number" expression="(#e2 + #seg3)"/>
  <Var name="e4" type="number" expression="(#e3 + #segL)"/>
  <Var name="capPerim" type="number" expression="(#e4 + #seg1)"/>
  <Var name="capPathT" type="number" expression="max(0,min(#capPerim,#capPerim*#batteryLevel/100))"/>
  <Var name="breathAlpha" type="number" expression="255"/>
  <!-- 充电白光流动变量 -->
  <Var name="chargeFlowVisible" type="number" expression="ifelse(eqs(@aod_desk_state,'1'), 0, ifelse(#aodState == 0, 0, ifelse(#batteryPlugType } 0, 1, 0)))"/>
  <Var name="chargePos" type="number" expression="(#chargeAnim / 360 * #capPerim)"/>
  <Var name="chargeTrailLen" type="number" expression="max(18,#capPerim * 0.18)"/>
  <Var name="chargeTail" type="number" expression="(#chargePos - #chargeTrailLen)"/>
  <Var name="dashA0" type="number" expression="max(0,#chargeTail)"/>
  <Var name="dashA1" type="number" expression="#chargePos"/>
  <Var name="dashB0" type="number" expression="ifelse(lt(#chargeTail,0),#chargeTail + #capPerim,#capPerim)"/>
  <Var name="dashB1" type="number" expression="#capPerim"/>

  <Var name="tickCount" type="number" expression="0" const="true"/>
  <Var name="autoRefreshTrigger" expression="#second" threshold="1">
    <Trigger>
      <FunctionCommand target="checkTick"/>
    </Trigger>
  </Var>

  <Function name="parseResult">
    <VariableCommand name="resultData" expression="strToJson(@result_json)" type="jsonO"/>
    <VariableCommand name="labelTitle" expression="jsonGetString($resultData, 'labelTitle')" type="string"/>
    <VariableCommand name="labelSubtitle" expression="jsonGetString($resultData, 'labelSubtitle')" type="string"/>
    <VariableCommand name="lowText" expression="jsonGetString($resultData, 'lowText')" type="string"/>
    <VariableCommand name="mediumText" expression="jsonGetString($resultData, 'mediumText')" type="string"/>
    <VariableCommand name="highText" expression="jsonGetString($resultData, 'highText')" type="string"/>
    <VariableCommand name="level1Text" expression="jsonGetString($resultData, 'level1Text')" type="string"/>
    <VariableCommand name="level2Text" expression="jsonGetString($resultData, 'level2Text')" type="string"/>
    <VariableCommand name="level3Text" expression="jsonGetString($resultData, 'level3Text')" type="string"/>
    <VariableCommand name="level4Text" expression="jsonGetString($resultData, 'level4Text')" type="string"/>
    <VariableCommand name="level5Text" expression="jsonGetString($resultData, 'level5Text')" type="string"/>
    <VariableCommand name="manufacturerLabel" expression="jsonGetString($resultData, 'manufacturerLabel')" type="string"/>
    <VariableCommand name="manufacturerText" expression="jsonGetString($resultData, 'manufacturerText')" type="string"/>
    <VariableCommand name="modelLabel" expression="jsonGetString($resultData, 'modelLabel')" type="string"/>
    <VariableCommand name="modelText" expression="jsonGetString($resultData, 'modelText')" type="string"/>
    <VariableCommand name="currentLabel" expression="jsonGetString($resultData, 'currentLabel')" type="string"/>
    <VariableCommand name="currentText" expression="jsonGetString($resultData, 'currentText')" type="string"/>
    <VariableCommand name="powerLabel" expression="jsonGetString($resultData, 'powerLabel')" type="string"/>
    <VariableCommand name="powerText" expression="jsonGetString($resultData, 'powerText')" type="string"/>
    <VariableCommand name="gradeText" expression="jsonGetString($resultData, 'gradeText')" type="string"/>
    <VariableCommand name="gradeIndex" expression="jsonGetString($resultData, 'gradeIndex')" type="string"/>
    <VariableCommand name="grade1Visible" expression="jsonGetString($resultData, 'grade1Visible')" type="string"/>
    <VariableCommand name="grade2Visible" expression="jsonGetString($resultData, 'grade2Visible')" type="string"/>
    <VariableCommand name="grade3Visible" expression="jsonGetString($resultData, 'grade3Visible')" type="string"/>
    <VariableCommand name="grade4Visible" expression="jsonGetString($resultData, 'grade4Visible')" type="string"/>
    <VariableCommand name="grade5Visible" expression="jsonGetString($resultData, 'grade5Visible')" type="string"/>
    <VariableCommand name="showCapsule" expression="jsonGetString($resultData, 'showCapsule')" type="string"/>
  </Function>

  <Function name="checkTick">
    <!-- AOD 门控：熄屏(aodState=0)时不再累计 tick，彻底停止每秒刷新/Shell 读取，省电 -->
    <IfCommand ifCondition="(#aodState == 1)">
      <Consequent>
        <VariableCommand name="tickCount" expression="(#tickCount + 1)" type="number"/>
        <IfCommand ifCondition="(#tickCount == #REFRESH_INTERVAL)">
          <Consequent>
            <VariableCommand name="tickCount" expression="0" type="number"/>
            <BinderCommand name="refreshData" command="refresh"/>
          </Consequent>
        </IfCommand>
      </Consequent>
    </IfCommand>
  </Function>

  <Function name="updateChargeAnim">
    <IfCommand ifCondition="((#batteryPlugType } 0) * (#aodState == 1))">
      <Consequent>
        <AnimationCommand target="chargeAnim" command="play"/>
        <FrameRateCommand rate="60"/>
      </Consequent>
      <Alternate>
        <AnimationCommand target="chargeAnim" command="pause"/>
        <VariableCommand name="chargeAnim" expression="0" type="number"/>
        <FrameRateCommand rate="0"/>
      </Alternate>
    </IfCommand>
  </Function>

  <!-- ============================================================
       内容总容器：始终绘制全部内容（能效标签 + 电量胶囊）。
       熄屏进入 AOD(aodState=0)时由顶部黑色蒙版整体调暗，内容仍隐约可见；
       亮屏(aodState=1)时蒙版消失，恢复正常亮度。
       ============================================================ -->
  <Group>
  <!-- 右侧蓝色地底图 -->
  <Rectangle x="(116 * #s)" y="(10 * #s)" w="(210 * #s)" h="(185 * #s)" fillColor="#4A86ED" cornerRadiusExp="(27 * #s)"/>
  <!-- 标题区 -->
  <Text x="(221 * #s)" y="(15 * #s)" size="(13 * #s)" fontPath="@font_path" textExp="@labelTitle" fontPathWeight="650" color="#FFFFFF" align="center"/>
  <Text x="(221 * #s)" y="(30 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@labelSubtitle" fontPathWeight="600" color="#FFFFFF" align="center"/>
  <!-- 中央能效区域 -->
  <Rectangle x="(123 * #s)" y="(44 * #s)" w="(196 * #s)" h="(104 * #s)" fillColor="#FFFFFF" cornerRadiusExp="(16 * #s)"/>

  <!-- 左侧耗能区间文字 -->
  <Text x="(136 * #s)" y="(57 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@lowText" fontPathWeight="650" color="#101010" alignV="center"/>
  <Text x="(136 * #s)" y="(85 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@mediumText" fontPathWeight="650" color="#101010" alignV="center"/>
  <Text x="(136 * #s)" y="(113 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@highText" fontPathWeight="650" color="#101010" alignV="center"/>

  <!-- 五条能效箭头 -->
  <!-- 1 级 -->
  <Rectangle x="(176.5 * #s)" y="(53.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#2F7B39" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
  <Rectangle x="(165 * #s)" y="(52 * #s)" w="(16 * #s)" h="(10 * #s)" fillColor="#2F7B39" cornerRadiusExp="(2 * #s)"/>
  <Text x="(176 * #s)" y="(57 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@level1Text" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  <!-- 2 级 -->
  <Rectangle x="(187.5 * #s)" y="(67.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#5EDC16" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
  <Rectangle x="(165 * #s)" y="(66 * #s)" w="(27 * #s)" h="(10 * #s)" fillColor="#5EDC16" cornerRadiusExp="(2 * #s)"/>
  <Text x="(182 * #s)" y="(71 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@level2Text" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  <!-- 3 级 -->
  <Rectangle x="(198.5 * #s)" y="(81.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#FFB318" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
  <Rectangle x="(165 * #s)" y="(80 * #s)" w="(38 * #s)" h="(10 * #s)" fillColor="#FFB318" cornerRadiusExp="(2 * #s)"/>
  <Text x="(188 * #s)" y="(85 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@level3Text" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  <!-- 4 级 -->
  <Rectangle x="(209.5 * #s)" y="(95.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#F25113" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
  <Rectangle x="(165 * #s)" y="(94 * #s)" w="(49 * #s)" h="(10 * #s)" fillColor="#F25113" cornerRadiusExp="(2 * #s)"/>
  <Text x="(194 * #s)" y="(99 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@level4Text" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  <!-- 5 级 -->
  <Rectangle x="(220.5 * #s)" y="(109.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#DC0B14" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
  <Rectangle x="(165 * #s)" y="(108 * #s)" w="(60 * #s)" h="(10 * #s)" fillColor="#DC0B14" cornerRadiusExp="(2 * #s)"/>
  <Text x="(200 * #s)" y="(113 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@level5Text" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>

  <!-- 当前能效等级指示 -->
  <Group visibility="(@gradeIndex == '1')">
    <Rectangle x="(285.5 * #s)" y="(53.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#2F7B39" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
    <Rectangle x="(288 * #s)" y="(52 * #s)" w="(22 * #s)" h="(10 * #s)" fillColor="#2F7B39" cornerRadiusExp="(2 * #s)"/>
    <Text x="(299 * #s)" y="(57 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@gradeText" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  </Group>
  <Group visibility="(@gradeIndex == '2')">
    <Rectangle x="(285.5 * #s)" y="(67.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#5EDC16" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
    <Rectangle x="(288 * #s)" y="(66 * #s)" w="(22 * #s)" h="(10 * #s)" fillColor="#5EDC16" cornerRadiusExp="(2 * #s)"/>
    <Text x="(299 * #s)" y="(71 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@gradeText" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  </Group>
  <Group visibility="(@gradeIndex == '3')">
    <Rectangle x="(285.5 * #s)" y="(81.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#FFB318" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
    <Rectangle x="(288 * #s)" y="(80 * #s)" w="(22 * #s)" h="(10 * #s)" fillColor="#FFB318" cornerRadiusExp="(2 * #s)"/>
    <Text x="(299 * #s)" y="(85 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@gradeText" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  </Group>
  <Group visibility="(@gradeIndex == '4')">
    <Rectangle x="(285.5 * #s)" y="(95.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#F25113" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
    <Rectangle x="(288 * #s)" y="(94 * #s)" w="(22 * #s)" h="(10 * #s)" fillColor="#F25113" cornerRadiusExp="(2 * #s)"/>
    <Text x="(299 * #s)" y="(99 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@gradeText" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  </Group>
  <Group visibility="(@gradeIndex == '5')">
    <Rectangle x="(285.5 * #s)" y="(109.5 * #s)" w="(7 * #s)" h="(7 * #s)" fillColor="#DC0B14" rotation="45" pivotX="(3.5 * #s)" pivotY="(3.5 * #s)"/>
    <Rectangle x="(288 * #s)" y="(108 * #s)" w="(22 * #s)" h="(10 * #s)" fillColor="#DC0B14" cornerRadiusExp="(2 * #s)"/>
    <Text x="(299 * #s)" y="(113 * #s)" size="(8 * #s)" fontPath="@font_path" textExp="@gradeText" fontPathWeight="700" color="#FFFFFF" align="center" alignV="center"/>
  </Group>

  <!-- 厂商和型号信息 -->
  <Text x="(136 * #s)" y="(125 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@manufacturerLabel" fontPathWeight="600" color="#101010"/>
  <Text x="(308 * #s)" y="(125 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@manufacturerText" fontPathWeight="600" color="#101010" align="right"/>
  <Text x="(136 * #s)" y="(136 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@modelLabel" fontPathWeight="600" color="#101010"/>
  <Text x="(308 * #s)" y="(136 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@modelText" fontPathWeight="600" color="#101010" align="right"/>

  <!-- 最下方两行 -->
  <Rectangle x="(123 * #s)" y="(154 * #s)" w="(196 * #s)" h="(34 * #s)" fillColor="#FFFFFF" cornerRadiusExp="(15 * #s)"/>
  <Rectangle x="(134 * #s)" y="(170 * #s)" w="(174 * #s)" h="(1 * #s)" fillColor="#D0D0D0"/>
  <Text x="(136 * #s)" y="(158 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@currentLabel" fontPathWeight="600" color="#101010"/>
  <Text x="(308 * #s)" y="(158 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@currentText" fontPathWeight="650" color="#101010" align="right"/>
  <Text x="(136 * #s)" y="(174 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@powerLabel" fontPathWeight="600" color="#101010"/>
  <Text x="(308 * #s)" y="(174 * #s)" size="(7 * #s)" fontPath="@font_path" textExp="@powerText" fontPathWeight="650" color="#101010" align="right"/>

  <Group x="(#scale + 2)" y="(#scale + 4)" visibility="eqs(@showCapsule,'1')">
    <!-- 药丸底框 -->
    <Rectangle x="0" y="0" w="(#capW * #scale)" h="(#capH * #scale)" fillColor="#00000000" strokeColor="#2E4E63" weight="(2 * #scale)" cap="round" strokeAlign="center" cornerRadiusExp="#capR*#scale" alpha="153"/>
    <!-- 段1 -->
    <Arc visibility="gt(#capPathT,0)" x="(#capR * #scale)" y="(#capR * #scale)" w="(#capW * #scale)" h="(#capW * #scale)" fillColor="#00000000" strokeColor="@ringColor" weight="(2 * #scale)" cap="round" strokeAlign="center" close="false" startAngle="-90" sweep="90*min(#seg1,max(0,#capPathT))/#seg1" alpha="#breathAlpha"/>
    <!-- 段2 -->
    <Line visibility="gt(#capPathT,#e1)" x="(#capW * #scale)" y="(#capR * #scale)" x1="(#capW * #scale)" y1="((#capR+min(#segL,max(0,#capPathT-#e1)))*#scale)" strokeColor="@ringColor" weight="(2 * #scale)" cap="round" strokeAlign="center" alpha="#breathAlpha"/>
    <!-- 段3 -->
    <Arc visibility="gt(#capPathT,#e2)" x="(#capR * #scale)" y="((#capH - #capR) * #scale)" w="(#capW * #scale)" h="(#capW * #scale)" fillColor="#00000000" strokeColor="@ringColor" weight="(2 * #scale)" cap="round" strokeAlign="center" close="false" startAngle="0" sweep="180*min(#seg3,max(0,#capPathT-#e2))/#seg3" alpha="#breathAlpha"/>
    <!-- 段4 -->
    <Line visibility="gt(#capPathT,#e3)" x="0" y="((#capH - #capR) * #scale)" x1="0" y1="((#capH-#capR-min(#segL,max(0,#capPathT-#e3)))*#scale)" strokeColor="@ringColor" weight="(2 * #scale)" cap="round" strokeAlign="center" alpha="#breathAlpha"/>
    <!-- 段5 -->
    <Arc visibility="gt(#capPathT,#e4)" x="(#capR * #scale)" y="(#capR * #scale)" w="(#capW * #scale)" h="(#capW * #scale)" fillColor="#00000000" strokeColor="@ringColor" weight="(2 * #scale)" cap="round" strokeAlign="center" close="false" startAngle="180" sweep="90*min(#seg1,max(0,#capPathT-#e4))/#seg1" alpha="#breathAlpha"/>

    <!-- 充电流光（充电时可见） -->
    <Group visibility="#chargeFlowVisible">
      <!-- pass A -->
      <Arc visibility="gt(min(#e1,#dashA1)-max(0,#dashA0),0)" x="(#capR*#scale)" y="(#capR*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(-90 + 90 * max(0,#dashA0) / #seg1)" sweep="(90 * max(0,min(#e1,#dashA1)-max(0,#dashA0)) / #seg1)" alpha="220"/>
      <Line visibility="gt(min(#e2,#dashA1)-max(#e1,#dashA0),0)" x="(#capW*#scale)" y="((#capR + max(#e1,#dashA0) - #e1)*#scale)" x1="(#capW*#scale)" y1="((#capR + min(#e2,#dashA1) - #e1)*#scale)" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" alpha="220"/>
      <Arc visibility="gt(min(#e3,#dashA1)-max(#e2,#dashA0),0)" x="(#capR*#scale)" y="((#capH-#capR)*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(180 * (max(#e2,#dashA0) - #e2) / #seg3)" sweep="(180 * max(0,min(#e3,#dashA1)-max(#e2,#dashA0)) / #seg3)" alpha="220"/>
      <Line visibility="gt(min(#e4,#dashA1)-max(#e3,#dashA0),0)" x="0" y="((#capH - #capR - (max(#e3,#dashA0) - #e3))*#scale)" x1="0" y1="((#capH - #capR - (min(#e4,#dashA1) - #e3))*#scale)" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" alpha="220"/>
      <Arc visibility="gt(min(#capPerim,#dashA1)-max(#e4,#dashA0),0)" x="(#capR*#scale)" y="(#capR*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(180 + 90 * (max(#e4,#dashA0) - #e4) / #seg1)" sweep="(90 * max(0,min(#capPerim,#dashA1)-max(#e4,#dashA0)) / #seg1)" alpha="220"/>
      <!-- pass B -->
      <Arc visibility="gt(min(#e1,#dashB1)-max(0,#dashB0),0)" x="(#capR*#scale)" y="(#capR*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(-90 + 90 * max(0,#dashB0) / #seg1)" sweep="(90 * max(0,min(#e1,#dashB1)-max(0,#dashB0)) / #seg1)" alpha="220"/>
      <Line visibility="gt(min(#e2,#dashB1)-max(#e1,#dashB0),0)" x="(#capW*#scale)" y="((#capR + max(#e1,#dashB0) - #e1)*#scale)" x1="(#capW*#scale)" y1="((#capR + min(#e2,#dashB1) - #e1)*#scale)" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" alpha="220"/>
      <Arc visibility="gt(min(#e3,#dashB1)-max(#e2,#dashB0),0)" x="(#capR*#scale)" y="((#capH-#capR)*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(180 * (max(#e2,#dashB0) - #e2) / #seg3)" sweep="(180 * max(0,min(#e3,#dashB1)-max(#e2,#dashB0)) / #seg3)" alpha="220"/>
      <Line visibility="gt(min(#e4,#dashB1)-max(#e3,#dashB0),0)" x="0" y="((#capH - #capR - (max(#e3,#dashB0) - #e3))*#scale)" x1="0" y1="((#capH - #capR - (min(#e4,#dashB1) - #e3))*#scale)" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" alpha="220"/>
      <Arc visibility="gt(min(#capPerim,#dashB1)-max(#e4,#dashB0),0)" x="(#capR*#scale)" y="(#capR*#scale)" w="(#capW*#scale)" h="(#capW*#scale)" fillColor="#00000000" strokeColor="#FFFFFF" weight="(3*#scale)" cap="butt" strokeAlign="center" close="false" startAngle="(180 + 90 * (max(#e4,#dashB0) - #e4) / #seg1)" sweep="(90 * max(0,min(#capPerim,#dashB1)-max(#e4,#dashB0)) / #seg1)" alpha="220"/>
    </Group>

    <!-- Pro Max 居中 -->
    <Text visibility="#isProMax"
      x="(#capX_center)" y="(#capH / 2 * #scale)"
      size="(10 * #scale)" fontPath="@font_path"
      textExp="(ifelse(gt(#batteryPlugType,0),'⚡','') + #batteryLevel + '%')"
      fontPathWeight="600" color="@ringColor" align="center" alignV="center"/>

    <!-- Pro 机型：左边图标，右边数字 -->
    <Text visibility="#isPro * gt(#batteryPlugType,0)"
      x="(#capX_icon)" y="(#capH / 2 * #scale)"
      size="(10 * #scale)" fontPath="@font_path"
      textExp="'⚡'"
      fontPathWeight="600" color="@ringColor" align="center" alignV="center"/>
    <Text visibility="#isPro"
      x="(#capX_num)" y="(#capH / 2 * #scale)"
      size="(10 * #scale)" fontPath="@font_path"
      textExp="#batteryLevel + '%'"
      fontPathWeight="600" color="@ringColor" align="center" alignV="center"/>
  </Group>
  </Group><!-- /内容总容器 -->

  <VariableBinders>
    <ContentProviderBinder name="getData" uriExp="@DATA_URI" columns="code,result">
      <Variable name="respCode" column="code" type="number"/>
      <Variable name="result_json" column="result" type="string"/>
      <Trigger>
        <FunctionCommand target="parseResult"/>
      </Trigger>
    </ContentProviderBinder>
    <BroadcastBinder action="android.intent.action.BATTERY_CHANGED">
      <Variable name="batteryLevel" type="int" extra="level"/>
      <Variable name="batteryPlugType" type="int" extra="plugged"/>
      <Variable name="batteryTemp" type="int" extra="temperature"/>
      <Variable name="batteryVolt" type="int" extra="voltage"/>
      <Variable name="batteryHealth" type="int" extra="health"/>
      <Trigger>
        <FunctionCommand target="updateChargeAnim"/>
      </Trigger>
    </BroadcastBinder>
    <ContentProviderBinder name="refreshData" uriExp="@UPDATE_URI" columns="code,result">
      <Variable name="refreshRespCode" column="code" type="number"/>
      <Trigger>
        <BinderCommand name="getData" command="refresh"/>
      </Trigger>
    </ContentProviderBinder>
  </VariableBinders>

  <ExternalCommands>
    <Trigger action="init">
      <VariableCommand name="aodState" expression="1" type="number"/>
      <BinderCommand name="refreshData" command="refresh"/>
      <FunctionCommand target="updateChargeAnim"/>
    </Trigger>
    <Trigger action="exitAod">
      <VariableCommand name="aodState" expression="1" type="number"/>
      <BinderCommand name="refreshData" command="refresh"/>
      <FunctionCommand target="updateChargeAnim"/>
    </Trigger>
    <Trigger action="notification_received">
      <BinderCommand name="getData" command="refresh"/>
    </Trigger>
    <Trigger action="resume">
      <VariableCommand name="aodState" expression="1" type="number"/>
      <BinderCommand name="refreshData" command="refresh"/>
      <FunctionCommand target="updateChargeAnim"/>
    </Trigger>
    <Trigger action="enterAod">
      <VariableCommand name="aodState" expression="0" type="number"/>
      <AnimationCommand target="chargeAnim" command="pause"/>
      <VariableCommand name="chargeAnim" expression="0" type="number"/>
      <FrameRateCommand rate="0"/>
    </Trigger>
    <Trigger action="pause">
      <VariableCommand name="aodState" expression="0" type="number"/>
      <AnimationCommand target="chargeAnim" command="pause"/>
      <VariableCommand name="chargeAnim" expression="0" type="number"/>
      <FrameRateCommand rate="0"/>
    </Trigger>
  </ExternalCommands>

  <!-- AOD 熄屏调暗：黑色蒙版仅在 aodState=0 时显示。
       alpha 越大压得越暗（0=不遮，255=全黑）；
       固定 180 ≈ 内容亮度剩 30%，觉得太暗调小（如 150），太亮调大（如 220）。 -->
  <Rectangle x="0" y="0" w="#view_width" h="#view_height" fillColor="#000000" alpha="180" visibility="#__isAod"/>
</Widget>